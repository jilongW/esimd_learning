#include <torch/all.h>
#include <torch/library.h>
#include <Python.h>

#include "sycl_tla/gemm_sycl_tla_interface.hpp"

torch::Tensor cutlass_gemm_sycl_tla(
    torch::Tensor ptr_A,
    torch::Tensor ptr_B,
    const c10::optional<at::Tensor>& ptr_bias,
    torch::Tensor ptr_D,
    int64_t N,
    int64_t K) {
    return XeGemm::cutlass_gemm_sycl_tla_impl(ptr_A, ptr_B, ptr_bias, ptr_D, N, K);
}

TORCH_LIBRARY_FRAGMENT(custom_esimd_kernels_vllm, m) {
  m.def(
      "cutlass_gemm_sycl_tla(Tensor ptr_A, Tensor ptr_B, Tensor? ptr_bias, Tensor ptr_D, "
      "int N, int K) -> Tensor");
  m.impl("cutlass_gemm_sycl_tla", torch::kXPU, &cutlass_gemm_sycl_tla);
}

PyMODINIT_FUNC PyInit_custom_esimd_kernels_cutlass_gemm() {
  static struct PyModuleDef module = {
      PyModuleDef_HEAD_INIT,
  "custom_esimd_kernels_cutlass_gemm",
      nullptr,
      0,
      nullptr,
      nullptr,
      nullptr,
      nullptr,
      nullptr,
  };
  return PyModule_Create(&module);
}
