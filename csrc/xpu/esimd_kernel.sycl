#include <ATen/ATen.h>
#include <ATen/Parallel.h>
#include <c10/xpu/XPUStream.h>
#include <torch/python.h>

#include <cstdint>
#include <sycl/sycl.hpp>

#include "esimd_kernels/fp8_GEMV_v2.h"
#include "esimd_kernels/fused_add_rms_norm_batched.h"
#include "esimd_kernels/gelu_tanh_and_mul.h"
#include "esimd_kernels/gemv_gelu_tanh_mul_fused.h"
#include "esimd_kernels/norm_gemv_fused.h"
#include "esimd_kernels/rms_norm.h"
#include "esimd_kernels/resadd_norm_gemv_fused.h"
#include "esimd_kernels/norm_gemv2_geglu_fused.h"

#define EXTRACT_PTR(var, tensor) auto var = reinterpret_cast<uint8_t*>(tensor.data_ptr())

inline int get_fp8_mode(const at::Tensor& weight) {
    return (weight.scalar_type() == at::ScalarType::Float8_e5m2) ? 1 : 0;
}

static inline sycl::queue& get_device_queue(const at::Tensor& tensor) {
    return c10::xpu::getCurrentXPUStream(tensor.device().index()).queue();
}

static inline bool is_supported_gemv_fp8_pern_config(int64_t vl, int64_t ks) {
    return (vl == 512 && (ks == 1 || ks == 2)) ||
           (vl == 256 && (ks == 1 || ks == 2 || ks == 4 || ks == 8)) ||
           (vl == 128 && (ks == 1 || ks == 2 || ks == 4 || ks == 8 || ks == 10));
}

static inline void validate_gemv_fp8_config(
    int64_t K,
    int64_t vl,
    int64_t ks,
    const char* op_name) {
    TORCH_CHECK(
        vl == 128 || vl == 256 || vl == 512,
        op_name,
        ": vl must be one of 128, 256, 512"
    );
    TORCH_CHECK(
        ks == 1 || ks == 2 || ks == 4 || ks == 8 || ks == 10,
        op_name,
        ": ks must be one of 1, 2, 4, 8, 10"
    );
    TORCH_CHECK(
        is_supported_gemv_fp8_pern_config(vl, ks),
        op_name,
        ": unsupported vl/ks combination"
    );
    TORCH_CHECK(
        K % ks == 0,
        op_name,
        ": K must be divisible by ks"
    );
    TORCH_CHECK(
        K % vl == 0,
        op_name,
        ": K must be divisible by vl"
    );
    TORCH_CHECK(
        (K / ks) % vl == 0,
        op_name,
        ": K / ks must be divisible by vl"
    );
}

static inline void validate_gemv_fp8_io(
    const at::Tensor& input,
    const at::Tensor& output,
    const char* op_name) {
    TORCH_CHECK(
        input.scalar_type() == at::ScalarType::Half || input.scalar_type() == at::ScalarType::BFloat16,
        op_name,
        ": input must be fp16 or bf16"
    );
    TORCH_CHECK(
        output.scalar_type() == at::ScalarType::Half || output.scalar_type() == at::ScalarType::BFloat16,
        op_name,
        ": output must be fp16 or bf16"
    );
    TORCH_CHECK(
        input.scalar_type() == output.scalar_type(),
        op_name,
        ": input and output must have the same dtype"
    );
}

at::Tensor esimd_gemv_fp8_pern(
    at::Tensor input, at::Tensor weight, at::Tensor weight_scale,
    at::Tensor output,
    int64_t N, int64_t K, int64_t vl, int64_t ks) {
    validate_gemv_fp8_io(input, output, "esimd_gemv_fp8_pern");
    validate_gemv_fp8_config(K, vl, ks, "esimd_gemv_fp8_pern");
    EXTRACT_PTR(p_in, input); EXTRACT_PTR(p_w, weight);
    EXTRACT_PTR(p_sc, weight_scale); EXTRACT_PTR(p_out, output);
    auto& dpcpp_queue = get_device_queue(input);
    GEMV_fp8_pern_host(
        p_in,
        p_w,
        p_sc,
        p_out,
        N,
        K,
        (int)vl,
        (int)ks,
        input.scalar_type() == at::ScalarType::BFloat16,
        output.scalar_type() == at::ScalarType::BFloat16,
        get_fp8_mode(weight),
        dpcpp_queue);
    return output;
}

at::Tensor esimd_gemv_fp8(
    at::Tensor input, at::Tensor weight, at::Tensor weight_scale,
    at::Tensor output) {
    int64_t N = weight.size(0);
    int64_t K = weight.size(1);

    validate_gemv_fp8_io(input, output, "esimd_gemv_fp8");
    TORCH_CHECK(
        weight_scale.numel() == 1  || weight_scale.numel() == 2 || weight_scale.numel() == N,
        "esimd_gemv_fp8: scale must be a scalar or have N elements, got ",
        weight_scale.numel(),
        " for N=",
        N
    );

    EXTRACT_PTR(p_in, input); EXTRACT_PTR(p_w, weight);
    EXTRACT_PTR(p_sc, weight_scale); EXTRACT_PTR(p_out, output);
    auto& dpcpp_queue = get_device_queue(input);
    bool input_is_bf16 = input.scalar_type() == at::ScalarType::BFloat16;
    bool output_is_bf16 = output.scalar_type() == at::ScalarType::BFloat16;
    int fp8_mode = get_fp8_mode(weight);

    if (weight_scale.numel() == 1 || weight_scale.numel() == 2) {
        int vl, ks;
        select_vl_ks_pert((uint32_t)N, (uint32_t)K, vl, ks);
        GEMV_fp8_pert_host(
            p_in,
            p_w,
            p_sc,
            p_out,
            N,
            K,
            vl,
            ks,
            input_is_bf16,
            output_is_bf16,
            fp8_mode,
            dpcpp_queue);
    } else {
        int vl, ks;
        select_vl_ks_pern((uint32_t)N, (uint32_t)K, vl, ks);
        GEMV_fp8_pern_host(
            p_in,
            p_w,
            p_sc,
            p_out,
            N,
            K,
            vl,
            ks,
            input_is_bf16,
            output_is_bf16,
            fp8_mode,
            dpcpp_queue);
    }

    return output;
}

at::Tensor esimd_gemv_fp8_pert(
    at::Tensor input, at::Tensor weight, at::Tensor weight_scale,
    at::Tensor output,
    int64_t N, int64_t K, int64_t vl, int64_t ks) {
    validate_gemv_fp8_io(input, output, "esimd_gemv_fp8_pert");
    validate_gemv_fp8_config(K, vl, ks, "esimd_gemv_fp8_pert");

    EXTRACT_PTR(p_in, input); EXTRACT_PTR(p_w, weight);
    EXTRACT_PTR(p_sc, weight_scale); EXTRACT_PTR(p_out, output);
    auto& dpcpp_queue = get_device_queue(input);
    GEMV_fp8_pert_host(
        p_in,
        p_w,
        p_sc,
        p_out,
        (uint32_t)N,
        (uint32_t)K,
        (int)vl,
        (int)ks,
        input.scalar_type() == at::ScalarType::BFloat16,
        output.scalar_type() == at::ScalarType::BFloat16,
        get_fp8_mode(weight),
        dpcpp_queue);

    return output;
}

// ---- Per-tensor scale variants (N/K auto-detected from tensor shapes) ----

//  ---- Need k >= 512 ----
at::Tensor esimd_fused_add_rms_norm_batched(
    at::Tensor hidden_states,  // [rows, K] — input/output
    at::Tensor residual,       // [rows, K] — updated in-place
    at::Tensor weight,         // [K] — Gemma weight (w+1.0)
    double eps)
{
    int rows = (int)hidden_states.size(0);
    int K = (int)hidden_states.size(-1);
    auto& dpcpp_queue = get_device_queue(hidden_states);

    TORCH_CHECK(
        hidden_states.scalar_type() == at::ScalarType::Half ||
            hidden_states.scalar_type() == at::ScalarType::BFloat16,
        "esimd_fused_add_rms_norm_batched: hidden_states must be fp16 or bf16"
    );
    TORCH_CHECK(
        residual.scalar_type() == hidden_states.scalar_type(),
        "esimd_fused_add_rms_norm_batched: residual must match hidden_states dtype"
    );
    TORCH_CHECK(
        weight.scalar_type() == hidden_states.scalar_type(),
        "esimd_fused_add_rms_norm_batched: weight must match hidden_states dtype"
    );

    fused_add_rms_norm_batched_host(
        reinterpret_cast<uint8_t*>(hidden_states.data_ptr()),
        reinterpret_cast<uint8_t*>(residual.data_ptr()),
        reinterpret_cast<const uint8_t*>(weight.data_ptr()),
        rows,
        K,
        (float)eps,
        hidden_states.scalar_type() == at::ScalarType::BFloat16,
        dpcpp_queue);

    return hidden_states;
}

at::Tensor esimd_rms_norm(
    at::Tensor hidden_states,
    at::Tensor weight,
    double eps,
    at::Tensor output,
    int64_t vl,
    int64_t ks)
{
    TORCH_CHECK(
        hidden_states.scalar_type() == at::ScalarType::Half ||
            hidden_states.scalar_type() == at::ScalarType::BFloat16,
        "esimd_rms_norm: hidden_states must be fp16 or bf16"
    );
    TORCH_CHECK(
        weight.scalar_type() == hidden_states.scalar_type(),
        "esimd_rms_norm: weight must match hidden_states dtype"
    );
    TORCH_CHECK(
        output.scalar_type() == hidden_states.scalar_type(),
        "esimd_rms_norm: output must match hidden_states dtype"
    );
    TORCH_CHECK(
        hidden_states.dim() >= 2,
        "esimd_rms_norm: hidden_states must have at least 2 dimensions"
    );
    TORCH_CHECK(
        weight.dim() == 1,
        "esimd_rms_norm: weight must be a 1D tensor"
    );
    TORCH_CHECK(
        output.sizes() == hidden_states.sizes(),
        "esimd_rms_norm: output shape must match hidden_states"
    );

    int K = (int)hidden_states.size(hidden_states.dim() - 1);
    int64_t rows64 = hidden_states.numel() / K;
    TORCH_CHECK(rows64 <= std::numeric_limits<int>::max(), "esimd_rms_norm: flattened rows exceed int range");
    int rows = (int)rows64;

    TORCH_CHECK(
        weight.size(0) == K,
        "esimd_rms_norm: weight size must match hidden_states last dimension"
    );
    TORCH_CHECK(
        vl == 128 || vl == 256 || vl == 512 || vl == 1024,
        "esimd_rms_norm: vl must be one of 128, 256, 512, 1024"
    );
    TORCH_CHECK(
        ks == 1 || ks == 2 || ks == 5 || ks == 8 || ks == 10,
        "esimd_rms_norm: ks must be one of 1, 2, 5, 8, 10"
    );
    TORCH_CHECK(
        K % (int)vl == 0,
        "esimd_rms_norm: hidden size must be divisible by vl"
    );
    TORCH_CHECK(
        ((int64_t)vl * ks < K) || (K == 256 && vl == 256 && ks == 1),
        "esimd_rms_norm: vl * ks must be smaller than hidden size unless using the 256:1 specialization"
    );

    auto& dpcpp_queue = get_device_queue(hidden_states);

    rms_norm_host(
        reinterpret_cast<const uint8_t*>(hidden_states.data_ptr()),
        reinterpret_cast<const uint8_t*>(weight.data_ptr()),
        reinterpret_cast<uint8_t*>(output.data_ptr()),
        rows,
        K,
        (float)eps,
        (int)vl,
        (int)ks,
        hidden_states.scalar_type() == at::ScalarType::BFloat16,
        dpcpp_queue);

    return output;
}

at::Tensor esimd_norm_gemv_fp8_pert(
    at::Tensor hidden_states,
    at::Tensor norm_weight,
    at::Tensor gemv_weight,
    at::Tensor gemv_scale,
    at::Tensor output,
    double eps,
    int64_t vl,
    int64_t ks)
{
    int total_N = (int)gemv_weight.size(0);
    TORCH_CHECK(
        total_N % 2 == 0,
        "esimd_gemv_gelu_tanh_mul_fp8_pert: gemv_weight rows must be even ([2N, K])"
    );
    int N = total_N / 2;
    int K = (int)gemv_weight.size(1);
    int gemv_scale_count = (int)gemv_scale.numel();
    int fp8_mode = get_fp8_mode(gemv_weight);

    TORCH_CHECK(
        hidden_states.scalar_type() == at::ScalarType::Half,
        "esimd_norm_gemv_fp8_pert: hidden_states must be fp16"
    );
    TORCH_CHECK(
        norm_weight.scalar_type() == at::ScalarType::Half,
        "esimd_norm_gemv_fp8_pert: norm_weight must be fp16"
    );
    TORCH_CHECK(
        output.scalar_type() == at::ScalarType::Half,
        "esimd_norm_gemv_fp8_pert: output must be fp16"
    );
    TORCH_CHECK(
        hidden_states.dim() == 2 && hidden_states.size(0) == 1,
        "esimd_norm_gemv_fp8_pert: hidden_states must have shape [1, K]"
    );
    TORCH_CHECK(
        norm_weight.dim() == 1 && norm_weight.size(0) == K,
        "esimd_norm_gemv_fp8_pert: norm_weight must have shape [K]"
    );
    TORCH_CHECK(
        gemv_scale.scalar_type() == at::ScalarType::Float,
        "esimd_norm_gemv_fp8_pert: gemv_scale must be float32"
    );
    TORCH_CHECK(
        gemv_scale.numel() == 1 || gemv_scale.numel() == 2,
        "esimd_norm_gemv_fp8_pert: gemv_scale must have 1 or 2 elements"
    );
    TORCH_CHECK(
        output.numel() == N,
        "esimd_norm_gemv_fp8_pert: output must have N elements"
    );

    TORCH_CHECK(
        (vl == 0 && ks == 0) || (vl != 0 && ks != 0),
        "esimd_norm_gemv_fp8_pert: vl and ks must both be zero for auto-select or both be explicit"
    );

    if (vl != 0 || ks != 0) {
        validate_gemv_fp8_config(K, vl, ks, "esimd_norm_gemv_fp8_pert");
    }

    auto& dpcpp_queue = get_device_queue(hidden_states);

    if (vl == 0 && ks == 0) {
        norm_gemv_fp8_pert_host(
            reinterpret_cast<const fp16*>(hidden_states.data_ptr()),
            reinterpret_cast<const fp16*>(norm_weight.data_ptr()),
            reinterpret_cast<const uint8_t*>(gemv_weight.data_ptr()),
            gemv_scale.data_ptr<float>(),
            reinterpret_cast<fp16*>(output.data_ptr()),
            N,
            K,
            (float)eps,
            fp8_mode,
            dpcpp_queue);
    } else {
        norm_gemv_fp8_pert_host(
            reinterpret_cast<const fp16*>(hidden_states.data_ptr()),
            reinterpret_cast<const fp16*>(norm_weight.data_ptr()),
            reinterpret_cast<const uint8_t*>(gemv_weight.data_ptr()),
            gemv_scale.data_ptr<float>(),
            reinterpret_cast<fp16*>(output.data_ptr()),
            N,
            K,
            (int)vl,
            (int)ks,
            (float)eps,
            fp8_mode,
            dpcpp_queue);
    }

    return output;
}

at::Tensor esimd_gemv_gelu_tanh_mul_fp8_pert(
    at::Tensor hidden_states,
    at::Tensor gemv_weight,
    at::Tensor gemv_scale,
    at::Tensor output,
    int64_t vl,
    int64_t ks)
{
    int total_N = (int)gemv_weight.size(0);
    TORCH_CHECK(
        total_N % 2 == 0,
        "esimd_gemv_gelu_tanh_mul_fp8_pert: gemv_weight rows must be even ([2N, K])"
    );
    int N = total_N / 2;
    int K = (int)gemv_weight.size(1);
    int gemv_scale_count = (int)gemv_scale.numel();
    int fp8_mode = get_fp8_mode(gemv_weight);

    TORCH_CHECK(
        hidden_states.scalar_type() == at::ScalarType::Half,
        "esimd_gemv_gelu_tanh_mul_fp8_pert: hidden_states must be fp16"
    );
    TORCH_CHECK(
        output.scalar_type() == at::ScalarType::Half,
        "esimd_gemv_gelu_tanh_mul_fp8_pert: output must be fp16"
    );
    TORCH_CHECK(
        hidden_states.dim() == 2 && hidden_states.size(0) == 1,
        "esimd_gemv_gelu_tanh_mul_fp8_pert: hidden_states must have shape [1, K]"
    );
    TORCH_CHECK(
        gemv_scale.scalar_type() == at::ScalarType::Float,
        "esimd_gemv_gelu_tanh_mul_fp8_pert: gemv_scale must be float32"
    );
    TORCH_CHECK(
        gemv_scale.numel() == 1 || gemv_scale.numel() == 2,
        "esimd_gemv_gelu_tanh_mul_fp8_pert: gemv_scale must have 1 or 2 elements"
    );
    TORCH_CHECK(
        output.numel() == N,
        "esimd_gemv_gelu_tanh_mul_fp8_pert: output must have N elements where gemv_weight is [2N, K]"
    );

    TORCH_CHECK(
        (vl == 0 && ks == 0) || (vl != 0 && ks != 0),
        "esimd_gemv_gelu_tanh_mul_fp8_pert: vl and ks must both be zero for auto-select or both be explicit"
    );

    if (vl != 0 || ks != 0) {
        validate_gemv_fp8_config(K, vl, ks, "esimd_gemv_gelu_tanh_mul_fp8_pert");
    }

    auto& dpcpp_queue = get_device_queue(hidden_states);

    if (vl == 0 && ks == 0) {
        gemv_gelu_tanh_mul_fp8_pert_host(
            reinterpret_cast<const fp16*>(hidden_states.data_ptr()),
            reinterpret_cast<const uint8_t*>(gemv_weight.data_ptr()),
            gemv_scale.data_ptr<float>(),
            reinterpret_cast<fp16*>(output.data_ptr()),
            N,
            K,
            gemv_scale_count,
            fp8_mode,
            dpcpp_queue);
    } else {
        gemv_gelu_tanh_mul_fp8_pert_host(
            reinterpret_cast<const fp16*>(hidden_states.data_ptr()),
            reinterpret_cast<const uint8_t*>(gemv_weight.data_ptr()),
            gemv_scale.data_ptr<float>(),
            reinterpret_cast<fp16*>(output.data_ptr()),
            N,
            K,
            (int)vl,
            (int)ks,
            gemv_scale_count,
            fp8_mode,
            dpcpp_queue);
    }

    return output;
}

at::Tensor esimd_gelu_tanh_and_mul(
    at::Tensor input,
    at::Tensor output,
    int64_t vl,
    int64_t ks)
{
    TORCH_CHECK(
        input.scalar_type() == at::ScalarType::Half || input.scalar_type() == at::ScalarType::BFloat16,
        "esimd_gelu_tanh_and_mul: input must be fp16 or bf16"
    );
    TORCH_CHECK(
        output.scalar_type() == input.scalar_type(),
        "esimd_gelu_tanh_and_mul: output must have the same dtype as input"
    );
    TORCH_CHECK(
        input.dim() == 2,
        "esimd_gelu_tanh_and_mul: input must be 2D [M, 2D]"
    );
    TORCH_CHECK(
        input.size(1) % 2 == 0,
        "esimd_gelu_tanh_and_mul: last dim must be even"
    );
    TORCH_CHECK(
        output.dim() == 2 && output.size(0) == input.size(0) && output.size(1) == input.size(1) / 2,
        "esimd_gelu_tanh_and_mul: output must have shape [M, D]"
    );
    TORCH_CHECK(
        input.size(1) % 128 == 0,
        "esimd_gelu_tanh_and_mul: input last dim must be divisible by 128"
    );

    auto rows = (int)input.size(0);
    auto cols = (int)input.size(1);
    bool is_bf16 = input.scalar_type() == at::ScalarType::BFloat16;

    TORCH_CHECK(
        (vl == 0 && ks == 0) || (vl != 0 && ks != 0),
        "esimd_gelu_tanh_and_mul: vl and ks must both be zero for auto-select or both be explicit"
    );

    if (vl != 0 || ks != 0) {
        TORCH_CHECK(
            vl == 128 || vl == 256 || vl == 512,
            "esimd_gelu_tanh_and_mul: vl must be one of 128, 256, 512"
        );

        int half_cols = cols / 2;
        TORCH_CHECK(
            half_cols % vl == 0,
            "esimd_gelu_tanh_and_mul: output width must be divisible by vl"
        );

        int chunks_per_row = half_cols / (int)vl;
        TORCH_CHECK(
            ks >= 1 && ks <= 64 && ks <= chunks_per_row,
            "esimd_gelu_tanh_and_mul: ks must be in [1, min(chunks_per_row, 64)]"
        );
    }

    auto& dpcpp_queue = get_device_queue(input);
    if (vl == 0 && ks == 0) {
        gelu_tanh_and_mul_host(
            reinterpret_cast<const uint8_t*>(input.data_ptr()),
            reinterpret_cast<uint8_t*>(output.data_ptr()),
            rows,
            cols,
            is_bf16,
            dpcpp_queue);
    } else {
        gelu_tanh_and_mul_host(
            reinterpret_cast<const uint8_t*>(input.data_ptr()),
            reinterpret_cast<uint8_t*>(output.data_ptr()),
            rows,
            cols,
            (int)vl,
            (int)ks,
            is_bf16,
            dpcpp_queue);
    }
    return output;
}

at::Tensor esimd_norm_gemv2_geglu_fp8_pert(
    at::Tensor hidden_states,
    at::Tensor norm_weight,
    at::Tensor gemv_weight0,
    at::Tensor gemv_scale0,
    at::Tensor gemv_weight1,
    at::Tensor gemv_scale1,
    at::Tensor output,
    double eps,
    int64_t vl,
    int64_t ks)
{
    int N0 = (int)gemv_weight0.size(0);
    int N1 = (int)gemv_weight1.size(0);
    int K = (int)gemv_weight0.size(1);

    TORCH_CHECK(
        hidden_states.scalar_type() == at::ScalarType::Half,
        "esimd_norm_gemv2_geglu_fp8_pert: hidden_states must be fp16"
    );
    TORCH_CHECK(
        norm_weight.scalar_type() == at::ScalarType::Half,
        "esimd_norm_gemv2_geglu_fp8_pert: norm_weight must be fp16"
    );
    TORCH_CHECK(
        hidden_states.dim() == 2 && hidden_states.size(0) == 1,
        "esimd_norm_gemv2_geglu_fp8_pert: hidden_states must have shape [1, K]"
    );
    TORCH_CHECK(
        norm_weight.dim() == 1 && norm_weight.size(0) == K,
        "esimd_norm_gemv2_geglu_fp8_pert: norm_weight must have shape [K]"
    );
    TORCH_CHECK(
        gemv_weight1.dim() == 2 && gemv_weight1.size(1) == K,
        "esimd_norm_gemv2_geglu_fp8_pert: gemv_weight1 must have shape [N1, K]"
    );
    TORCH_CHECK(
        gemv_scale0.scalar_type() == at::ScalarType::Float && gemv_scale0.numel() == 1,
        "esimd_norm_gemv2_geglu_fp8_pert: gemv_scale0 must be a float32 scalar"
    );
    TORCH_CHECK(
        gemv_scale1.scalar_type() == at::ScalarType::Float && gemv_scale1.numel() == 1,
        "esimd_norm_gemv2_geglu_fp8_pert: gemv_scale1 must be a float32 scalar"
    );
    TORCH_CHECK(
        output.scalar_type() == at::ScalarType::Half,
        "esimd_norm_gemv2_geglu_fp8_pert: output must be fp16"
    );
    TORCH_CHECK(
        output.dim() == 2 && output.size(0) == 1 && output.size(1) == N0,
        "esimd_norm_gemv2_geglu_fp8_pert: output must have shape [1, N0]"
    );

    TORCH_CHECK(
        (vl == 0 && ks == 0) || (vl != 0 && ks != 0),
        "esimd_norm_gemv2_geglu_fp8_pert: vl and ks must both be zero for auto-select or both be explicit"
    );

    if (vl != 0 || ks != 0) {
        validate_gemv_fp8_config(K, vl, ks, "esimd_norm_gemv2_geglu_fp8_pert");
    }

    auto& dpcpp_queue = get_device_queue(hidden_states);

    if (vl == 0 && ks == 0) {
        norm_gemv2_geglu_fp8_pert_host(
            reinterpret_cast<const fp16*>(hidden_states.data_ptr()),
            reinterpret_cast<const fp16*>(norm_weight.data_ptr()),
            reinterpret_cast<const uint8_t*>(gemv_weight0.data_ptr()),
            gemv_scale0.data_ptr<float>(),
            reinterpret_cast<fp16*>(output.data_ptr()),
            reinterpret_cast<const uint8_t*>(gemv_weight1.data_ptr()),
            gemv_scale1.data_ptr<float>(),
            N0,
            N1,
            K,
            (float)eps,
            get_fp8_mode(gemv_weight0),
            dpcpp_queue);
    } else {
        norm_gemv2_geglu_fp8_pert_host(
            reinterpret_cast<const fp16*>(hidden_states.data_ptr()),
            reinterpret_cast<const fp16*>(norm_weight.data_ptr()),
            reinterpret_cast<const uint8_t*>(gemv_weight0.data_ptr()),
            gemv_scale0.data_ptr<float>(),
            reinterpret_cast<fp16*>(output.data_ptr()),
            reinterpret_cast<const uint8_t*>(gemv_weight1.data_ptr()),
            gemv_scale1.data_ptr<float>(),
            N0,
            N1,
            K,
            (int)vl,
            (int)ks,
            (float)eps,
            get_fp8_mode(gemv_weight0),
            dpcpp_queue);
    }

    return output;
}

// ---- Fused ResidualAdd + RMSNorm + FP8 GEMV ----

at::Tensor esimd_resadd_norm_gemv_fp8_pert(
    at::Tensor hidden_states,  // [1, K] fp16
    at::Tensor residual,       // [1, K] fp16 — updated in-place
    at::Tensor norm_weight,    // [K] fp16 — Gemma (w+1.0)
    at::Tensor gemv_weight,    // [N, K] FP8
    at::Tensor gemv_scale,     // [1] or [2] float32
    at::Tensor output,         // [1, N] fp16 — router logits
    at::Tensor normed_out,     // [1, K] fp16 — normed hidden for experts
    double eps)
{
    int N = (int)gemv_weight.size(0);
    int K = (int)gemv_weight.size(1);
    int fp8_mode = get_fp8_mode(gemv_weight);
    int gemv_scale_count = (int)gemv_scale.numel();

    TORCH_CHECK(
        gemv_scale.scalar_type() == at::ScalarType::Float,
        "esimd_resadd_norm_gemv_fp8_pert: gemv_scale must be float32"
    );
    TORCH_CHECK(
        gemv_scale_count == 1 || gemv_scale_count == 2,
        "esimd_resadd_norm_gemv_fp8_pert: gemv_scale must have 1 or 2 elements"
    );

    auto& dpcpp_queue = get_device_queue(hidden_states);

    resadd_norm_gemv_fp8_pert_host(
        reinterpret_cast<fp16*>(hidden_states.data_ptr()),
        reinterpret_cast<fp16*>(residual.data_ptr()),
        reinterpret_cast<const fp16*>(norm_weight.data_ptr()),
        reinterpret_cast<const uint8_t*>(gemv_weight.data_ptr()),
        gemv_scale.data_ptr<float>(),
        reinterpret_cast<fp16*>(output.data_ptr()),
        reinterpret_cast<fp16*>(normed_out.data_ptr()),
        N, K, gemv_scale_count, (float)eps, fp8_mode,
        dpcpp_queue);

    return output;
}
