#include <ATen/ATen.h>
#include <ATen/Parallel.h>
#include <c10/xpu/XPUStream.h>
#include <torch/python.h>

#include <cstdint>
#include <sycl/sycl.hpp>

#include "esimd_kernels/fp8_GEMV_v2.h"
#include "esimd_kernels/fused_add_rms_norm_batched.h"
#include "esimd_kernels/rms_norm.h"
#include "esimd_kernels/resadd_norm_gemv_fused.h"

#define EXTRACT_PTR(var, tensor) auto var = reinterpret_cast<uint8_t*>(tensor.data_ptr())

inline int get_fp8_mode(const at::Tensor& weight) {
    return (weight.scalar_type() == at::ScalarType::Float8_e5m2) ? 1 : 0;
}

static inline sycl::queue& get_device_queue(const at::Tensor& tensor) {
    return c10::xpu::getCurrentXPUStream(tensor.device().index()).queue();
}

static inline bool is_supported_gemv_fp8_pern_config(int64_t vl, int64_t ks) {
    return (vl == 512 && (ks == 1 || ks == 2)) ||
           (vl == 256 && (ks == 1 || ks == 2 || ks == 4 || ks == 8)) ||
           (vl == 128 && (ks == 1 || ks == 2 || ks == 4 || ks == 8 || ks == 10));
}

at::Tensor esimd_gemv_fp8_pern(
    at::Tensor input, at::Tensor weight, at::Tensor weight_scale,
    at::Tensor output,
    int64_t N, int64_t K, int64_t vl, int64_t ks) {
    TORCH_CHECK(
        input.scalar_type() == at::ScalarType::Half || input.scalar_type() == at::ScalarType::BFloat16,
        "esimd_gemv_fp8_pern: input must be fp16 or bf16"
    );
    TORCH_CHECK(
        output.scalar_type() == at::ScalarType::Half || output.scalar_type() == at::ScalarType::BFloat16,
        "esimd_gemv_fp8_pern: output must be fp16 or bf16"
    );
    TORCH_CHECK(
        input.scalar_type() == output.scalar_type(),
        "esimd_gemv_fp8_pern: input and output must have the same dtype"
    );
    TORCH_CHECK(
        vl == 128 || vl == 256 || vl == 512,
        "esimd_gemv_fp8_pern: vl must be one of 128, 256, 512"
    );
    TORCH_CHECK(
        ks == 1 || ks == 2 || ks == 4 || ks == 8 || ks == 10,
        "esimd_gemv_fp8_pern: ks must be one of 1, 2, 4, 8, 10"
    );
    TORCH_CHECK(
        is_supported_gemv_fp8_pern_config(vl, ks),
        "esimd_gemv_fp8_pern: unsupported vl/ks combination"
    );
    TORCH_CHECK(
        K % ks == 0,
        "esimd_gemv_fp8_pern: K must be divisible by ks"
    );
    TORCH_CHECK(
        K % vl == 0,
        "esimd_gemv_fp8_pern: K must be divisible by vl"
    );
    TORCH_CHECK(
        (K / ks) % vl == 0,
        "esimd_gemv_fp8_pern: K / ks must be divisible by vl"
    );
    EXTRACT_PTR(p_in, input); EXTRACT_PTR(p_w, weight);
    EXTRACT_PTR(p_sc, weight_scale); EXTRACT_PTR(p_out, output);
    auto& dpcpp_queue = get_device_queue(input);
    GEMV_fp8_pern_host(
        p_in,
        p_w,
        p_sc,
        p_out,
        N,
        K,
        (int)vl,
        (int)ks,
        input.scalar_type() == at::ScalarType::BFloat16,
        output.scalar_type() == at::ScalarType::BFloat16,
        get_fp8_mode(weight),
        dpcpp_queue);
    return output;
}

// ---- Per-tensor scale variants (N/K auto-detected from tensor shapes) ----

at::Tensor esimd_gemv_fp8_pert(
    at::Tensor input, at::Tensor weight, at::Tensor weight_scale,
    at::Tensor output) {
    int64_t N = weight.size(0);
    int64_t K = weight.size(1);
    TORCH_CHECK(
        input.scalar_type() == at::ScalarType::Half || input.scalar_type() == at::ScalarType::BFloat16,
        "esimd_gemv_fp8_pert: input must be fp16 or bf16"
    );
    TORCH_CHECK(
        output.scalar_type() == at::ScalarType::Half || output.scalar_type() == at::ScalarType::BFloat16,
        "esimd_gemv_fp8_pert: output must be fp16 or bf16"
    );
    TORCH_CHECK(
        input.scalar_type() == output.scalar_type(),
        "esimd_gemv_fp8_pert: input and output must have the same dtype"
    );
    EXTRACT_PTR(p_in, input); EXTRACT_PTR(p_w, weight);
    EXTRACT_PTR(p_sc, weight_scale); EXTRACT_PTR(p_out, output);
    auto& dpcpp_queue = get_device_queue(input);
    GEMV_fp8_pert_host(
        p_in,
        p_w,
        p_sc,
        p_out,
        N,
        K,
        input.scalar_type() == at::ScalarType::BFloat16,
        output.scalar_type() == at::ScalarType::BFloat16,
        get_fp8_mode(weight),
        dpcpp_queue);
    return output;
}

//  ---- Need k >= 512 ----
at::Tensor esimd_fused_add_rms_norm_batched(
    at::Tensor hidden_states,  // [rows, K] — input/output
    at::Tensor residual,       // [rows, K] — updated in-place
    at::Tensor weight,         // [K] — Gemma weight (w+1.0)
    double eps)
{
    int rows = (int)hidden_states.size(0);
    int K = (int)hidden_states.size(-1);
    auto& dpcpp_queue = get_device_queue(hidden_states);

    TORCH_CHECK(
        hidden_states.scalar_type() == at::ScalarType::Half ||
            hidden_states.scalar_type() == at::ScalarType::BFloat16,
        "esimd_fused_add_rms_norm_batched: hidden_states must be fp16 or bf16"
    );
    TORCH_CHECK(
        residual.scalar_type() == hidden_states.scalar_type(),
        "esimd_fused_add_rms_norm_batched: residual must match hidden_states dtype"
    );
    TORCH_CHECK(
        weight.scalar_type() == hidden_states.scalar_type(),
        "esimd_fused_add_rms_norm_batched: weight must match hidden_states dtype"
    );

    fused_add_rms_norm_batched_host(
        reinterpret_cast<uint8_t*>(hidden_states.data_ptr()),
        reinterpret_cast<uint8_t*>(residual.data_ptr()),
        reinterpret_cast<const uint8_t*>(weight.data_ptr()),
        rows,
        K,
        (float)eps,
        hidden_states.scalar_type() == at::ScalarType::BFloat16,
        dpcpp_queue);

    return hidden_states;
}

at::Tensor esimd_rms_norm(
    at::Tensor hidden_states,
    at::Tensor weight,
    double eps,
    at::Tensor output,
    int64_t vl,
    int64_t ks)
{
    TORCH_CHECK(
        hidden_states.scalar_type() == at::ScalarType::Half ||
            hidden_states.scalar_type() == at::ScalarType::BFloat16,
        "esimd_rms_norm: hidden_states must be fp16 or bf16"
    );
    TORCH_CHECK(
        weight.scalar_type() == hidden_states.scalar_type(),
        "esimd_rms_norm: weight must match hidden_states dtype"
    );
    TORCH_CHECK(
        output.scalar_type() == hidden_states.scalar_type(),
        "esimd_rms_norm: output must match hidden_states dtype"
    );
    TORCH_CHECK(
        hidden_states.dim() >= 2,
        "esimd_rms_norm: hidden_states must have at least 2 dimensions"
    );
    TORCH_CHECK(
        weight.dim() == 1,
        "esimd_rms_norm: weight must be a 1D tensor"
    );
    TORCH_CHECK(
        output.sizes() == hidden_states.sizes(),
        "esimd_rms_norm: output shape must match hidden_states"
    );

    int K = (int)hidden_states.size(hidden_states.dim() - 1);
    int64_t rows64 = hidden_states.numel() / K;
    TORCH_CHECK(rows64 <= std::numeric_limits<int>::max(), "esimd_rms_norm: flattened rows exceed int range");
    int rows = (int)rows64;

    TORCH_CHECK(
        weight.size(0) == K,
        "esimd_rms_norm: weight size must match hidden_states last dimension"
    );
    TORCH_CHECK(
        vl == 128 || vl == 256 || vl == 512 || vl == 1024,
        "esimd_rms_norm: vl must be one of 128, 256, 512, 1024"
    );
    TORCH_CHECK(
        ks == 1 || ks == 2 || ks == 5 || ks == 8 || ks == 10,
        "esimd_rms_norm: ks must be one of 1, 2, 5, 8, 10"
    );
    TORCH_CHECK(
        K % (int)vl == 0,
        "esimd_rms_norm: hidden size must be divisible by vl"
    );
    TORCH_CHECK(
        ((int64_t)vl * ks < K) || (K == 256 && vl == 256 && ks == 1),
        "esimd_rms_norm: vl * ks must be smaller than hidden size unless using the 256:1 specialization"
    );

    auto& dpcpp_queue = get_device_queue(hidden_states);

    rms_norm_host(
        reinterpret_cast<const uint8_t*>(hidden_states.data_ptr()),
        reinterpret_cast<const uint8_t*>(weight.data_ptr()),
        reinterpret_cast<uint8_t*>(output.data_ptr()),
        rows,
        K,
        (float)eps,
        (int)vl,
        (int)ks,
        hidden_states.scalar_type() == at::ScalarType::BFloat16,
        dpcpp_queue);

    return output;
}

// ---- Fused ResidualAdd + RMSNorm + FP8 GEMV ----

at::Tensor esimd_resadd_norm_gemv_fp8_pert(
    at::Tensor hidden_states,  // [1, K] fp16
    at::Tensor residual,       // [1, K] fp16 — updated in-place
    at::Tensor norm_weight,    // [K] fp16 — Gemma (w+1.0)
    at::Tensor gemv_weight,    // [N, K] FP8
    at::Tensor gemv_scale,     // [1] or [2] float32
    at::Tensor output,         // [1, N] fp16 — router logits
    at::Tensor normed_out,     // [1, K] fp16 — normed hidden for experts
    double eps)
{
    int N = (int)gemv_weight.size(0);
    int K = (int)gemv_weight.size(1);
    int fp8_mode = get_fp8_mode(gemv_weight);
    int gemv_scale_count = (int)gemv_scale.numel();

    TORCH_CHECK(
        gemv_scale.scalar_type() == at::ScalarType::Float,
        "esimd_resadd_norm_gemv_fp8_pert: gemv_scale must be float32"
    );
    TORCH_CHECK(
        gemv_scale_count == 1 || gemv_scale_count == 2,
        "esimd_resadd_norm_gemv_fp8_pert: gemv_scale must have 1 or 2 elements"
    );

    auto& dpcpp_queue = get_device_queue(hidden_states);

    resadd_norm_gemv_fp8_pert_host(
        reinterpret_cast<fp16*>(hidden_states.data_ptr()),
        reinterpret_cast<fp16*>(residual.data_ptr()),
        reinterpret_cast<const fp16*>(norm_weight.data_ptr()),
        reinterpret_cast<const uint8_t*>(gemv_weight.data_ptr()),
        gemv_scale.data_ptr<float>(),
        reinterpret_cast<fp16*>(output.data_ptr()),
        reinterpret_cast<fp16*>(normed_out.data_ptr()),
        N, K, gemv_scale_count, (float)eps, fp8_mode,
        dpcpp_queue);

    return output;
}
